{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run Geral Heatmap",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.src.shared.mapping.Geral",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Run Empresas Heatmap",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.src.shared.mapping.Empresas",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["backend/tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}
